{
  "name": "oceanlang-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "npx vite dev --host",
    "build": "npx wrangler types && npx vite build",
    "preview": "npm run build && npx wrangler dev",
    "prepare": "npx svelte-kit sync || echo ''",
    "check": "npx wrangler types worker-configuration.d.ts --check && npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "npx wrangler types worker-configuration.d.ts",
    "deploy": "npm run build && npx wrangler deploy",
    "cf-typegen": "npx wrangler types worker-configuration.d.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.9",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.3",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
