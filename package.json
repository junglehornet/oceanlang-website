{
  "name": "oceanlang-website",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "docs": "python3 scripts/build_docs.py content/docs src/lib/docs.ts",
    "dev": "npx vite dev --host",
    "build": "npx wrangler types && npx vite build",
    "preview": "npm run build && npx wrangler dev",
    "prepare": "npx svelte-kit sync || echo ''",
    "check": "npx wrangler types worker-configuration.d.ts --check && npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npx svelte-kit sync && npx svelte-check --tsconfig ./tsconfig.json --watch",
    "gen": "npx wrangler types worker-configuration.d.ts",
    "deploy": "npm run build && npx wrangler deploy",
    "cf-typegen": "npx wrangler types worker-configuration.d.ts"
  },
  "devDependencies": {
    "@mdsvex/plugin-anchors": "^0.1.0",
    "@mdsvex/plugin-code-blocks": "^0.1.0",
    "@mdsvex/plugin-external-links": "^0.1.0",
    "@mdsvex/plugin-figures": "^0.1.0",
    "@mdsvex/plugin-page-data": "^0.1.0",
    "@mdsvex/plugin-toc": "^0.1.0",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^26.6.3",
    "mdsvex": "^1.0.1",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.144.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260926.1": true
  }
}
